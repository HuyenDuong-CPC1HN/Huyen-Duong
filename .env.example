# Copy to .env.local for local development. Vite exposes only VITE_* values to
# the browser; use the Supabase Project URL and anon/publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Migration script only — never set this as VITE_* and never deploy it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Firebase Admin service-account JSON (one-time local migration only).
FIREBASE_SERVICE_ACCOUNT_JSON=
